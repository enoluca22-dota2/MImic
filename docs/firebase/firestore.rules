rules_version = '2';
// MImic account sync (4.4). Each signed-in user can read and write only their own subtree;
// nothing is public, and no user can list or read another user's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
