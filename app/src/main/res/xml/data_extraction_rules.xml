<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ cloud backup and device-to-device transfer. Same policy as backup_rules.xml:
   everything except sign-ins (Navidrome login, YouTube Music session, WebView cookies, party token).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/music_server.preferences_pb" />
        <exclude domain="sharedpref" path="bitchord_auth.xml" />
        <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="mimic_listen_together.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/music_server.preferences_pb" />
        <exclude domain="sharedpref" path="bitchord_auth.xml" />
        <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="mimic_listen_together.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
