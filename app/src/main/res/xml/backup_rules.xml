<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup on Android 6–11 (Android 12+ reads data_extraction_rules.xml).
   Settings, themes, the library database and playlists are backed up as before. Sign-ins are not:
   the Navidrome password is encrypted with a key that never leaves this phone (useless elsewhere),
   and session cookies / party tokens must not sit in a cloud backup. After a restore on a new
   phone MImic asks to sign in again; nothing else changes.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/music_server.preferences_pb" />
    <exclude domain="sharedpref" path="bitchord_auth.xml" />
    <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
    <exclude domain="sharedpref" path="mimic_listen_together.xml" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
