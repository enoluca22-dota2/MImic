<?xml version="1.0" encoding="utf-8"?>
<!-- Full edition only: the media downloader merged from ENAGELYUCA (merged into the main manifest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Share a YouTube/TikTok link to MImic, or "Open with MImic" (never the default handler). -->
        <activity
            android:name="com.example.mimic.MainActivity"
            android:exported="true">
            <intent-filter android:label="@string/download_with_mimic">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/download_with_mimic">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/playlist" />
            </intent-filter>
            <intent-filter android:label="@string/download_with_mimic">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
                <data android:host="vm.tiktok.com" />
                <data android:host="vt.tiktok.com" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.mimic.downloader.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="com.example.mimic.downloader.download.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.example.mimic.downloader.download.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
